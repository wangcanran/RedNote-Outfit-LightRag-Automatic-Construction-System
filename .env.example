# Environment variables
# 程序只读取「项目根目录的 .env」，不会读本文件。请复制为 .env 再填密钥：
#   copy .env.example .env   （PowerShell / CMD）
# 4ZAPI：令牌填在 ANTHROPIC_API_KEY；Anthropic 兼容根地址不要带 /v1
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_BASE_URL=https://4zapi.com
# openai_compatible 打标签时用 OpenAI 兼容 base_url，一般为 https://4zapi.com/v1
# OPENAI_BASE_URL=https://4zapi.com/v1
# 与 4ZAPI 控制台「支持模型」名称一致（不对则请求失败，ai_extracted_tags 会空）
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# AI 打标签默认只用标题+正文；若要对配图做 Vision 再打标签，在代码里传 ai_tag_use_images=True

# Model configuration（与 config.Settings 字段对应：OPENAI_MODEL / LLM_TIMEOUT_SEC 等）
# OPENAI_MODEL=gpt-4-vision
# LLM_TIMEOUT_SEC=180
MODEL=gpt-5.1-2025-11-13
MAX_TOKENS=4096
TEMPERATURE=0.7

# Database
DATABASE_URL=sqlite:///./ecommerce.db

# API
API_HOST=0.0.0.0
API_PORT=8000
